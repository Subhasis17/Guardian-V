# Local demo API authentication; use a long random value outside localhost.
# Dashboard auth uses a provisioned password account, not DEMO_API_TOKEN.
# Enable HTTPS cookies on Render. Local HTTP development can leave false.
GUARDIAN_COOKIE_SECURE=false
GUARDIAN_AGENT_TOOL_TOKEN=replace-with-a-different-long-random-value
# Optional: SQLite file on durable storage. Parent directory must already exist.
GUARDIAN_DB_PATH=
# Independent sandbox bank; use the same service secret in both server processes.
MOCK_BANK_URL=http://127.0.0.1:8001
MOCK_BANK_SERVICE_SECRET=replace-with-a-long-random-secret

# Live voice integrations (server-side only)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_AGENT_ID=
MURF_API_KEY=
MURF_VOICE_ID=en-US-natalie
MURF_LOCALE=en-US
GUARDIAN_ASR_LANGUAGE=en
GUARDIAN_DEFAULT_LANGUAGE_LABEL=English — Natalie
GUARDIAN_DEFAULT_REPLY_LANGUAGE=English
GUARDIAN_DEFAULT_VOICE_PROFILE=default
# Agora manages the LLM; no separate LLM key or endpoint is needed.
GUARDIAN_PUBLIC_API_URL=
GUARDIAN_FRONTEND_ORIGINS=
# Dashboard destination after successful Google authorization.
GUARDIAN_FRONTEND_URL=http://127.0.0.1:5173
# Frontend build only: public backend base URL, never put secrets in VITE_ variables.
VITE_API_URL=http://127.0.0.1:8000

# Optional additional language profiles. Confirm that each Murf voice supports its locale.
# Keep this JSON on one line. Example shape (replace the voice ID with one from your Murf account):
# GUARDIAN_VOICE_PROFILES_JSON=[{"id":"hindi","label":"Hindi","asr_language":"hi","tts_locale":"hi-IN","tts_voice_id":"replace-with-supported-murf-voice","reply_language":"Hindi","greeting":"Namaste, I am Guardian. Tell me what happened.","auto_detect_input":false}]
GUARDIAN_VOICE_PROFILES_JSON=

# Optional authorized integrations; keep disabled until configured.
# sandbox keeps actions local; google enables explicitly approved Gmail/Calendar actions.
GUARDIAN_INTEGRATION_MODE=sandbox
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GUARDIAN_TRUSTED_CONTACT_EMAIL=

# Google OAuth credentials for Render deployment; local GOOGLE_CLIENT_* values remain separate.
GOOGLE_DEPLOY_CLIENT_ID=
GOOGLE_DEPLOY_CLIENT_SECRET=

# Fernet key for encrypted registration profiles and username lookup. Keep stable; back up separately.
GUARDIAN_PII_ENCRYPTION_KEY=

# Copy this deployment callback to Render GOOGLE_REDIRECT_URI and the deployment OAuth client.
GOOGLE_DEPLOY_REDIRECT_URI=https://guardian-api-j55w.onrender.com/api/integrations/google/callback
